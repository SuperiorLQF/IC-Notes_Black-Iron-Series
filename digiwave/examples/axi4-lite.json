  "texts": [
    {
      "id": "note_clk_15",
      "trackId": "clk",
      "t": 15,
      "y": 42,
      "text": "AXI4-Lite: WRITE #1 / READ #2",
      "content": "所有传输在 clk 上升沿且 VALID && READY 时发生。展开或滚动各通道组查看事务。",
      "size": 13,
      "color": "#ffe66d",
      "bgColor": "#252b35",
      "isSticky": true,
      "collapsed": true,
      "baseScale": 10
    },
    {
      "id": "note_AWADDR_20",
      "trackId": "AWADDR",
      "t": 20,
      "y": 42,
      "text": "WRITE #1: [0x40000010] ← 0xDEADBEEF",
      "content": "W 握手 25ns，AW 握手 35ns：写数据可先于地址到达。WSTRB=0xF，4 个字节有效。",
      "size": 13,
      "color": "#ffe66d",
      "bgColor": "#252b35",
      "isSticky": true,
      "collapsed": true,
      "baseScale": 10
    },
    {
      "id": "note_BVALID_50",
      "trackId": "BVALID",
      "t": 50,
      "y": 42,
      "text": "WRITE #1 response: OKAY @75ns",
      "content": "BVALID 从 50ns 保持到 BREADY；75ns 完成写响应。",
      "size": 13,
      "color": "#ffe66d",
      "bgColor": "#252b35",
      "isSticky": true,
      "collapsed": true,
      "baseScale": 10
    },
    {
      "id": "note_ARADDR_90",
      "trackId": "ARADDR",
      "t": 90,
      "y": 42,
      "text": "READ #2: [0x40000010]",
      "content": "105ns 接收读地址。",
      "size": 13,
      "color": "#ffe66d",
      "bgColor": "#252b35",
      "isSticky": true,
      "collapsed": true,
      "baseScale": 10
    },
    {
      "id": "note_RDATA_130",
      "trackId": "RDATA",
      "t": 130,
      "y": 42,
      "text": "READ #2: 0xDEADBEEF / OKAY @155ns",
      "content": "RVALID 期间数据保持稳定；RREADY 延迟至 150ns，155ns 完成读返回。",
      "size": 13,
      "color": "#ffe66d",
      "bgColor": "#252b35",
      "isSticky": true,
      "collapsed": true,
      "baseScale": 10
    }
  ],
