  "texts": [
    {
      "id": "note_AWADDR_20",
      "trackId": "AWADDR",
      "t": 20,
      "y": 42,
      "text": "WRITE burst #1: 4 × 32-bit INCR",
      "content": "AWLEN=3 表示 4 拍；AWSIZE=2 表示每拍 4 字节；AWBURST=1 表示 INCR。AWID=3。地址依次为 0x80000000/04/08/0C。",
      "size": 13,
      "color": "#ffe66d",
      "bgColor": "#252b35",
      "isSticky": true,
      "collapsed": true,
      "baseScale": 10
    },
    {
      "id": "note_WDATA_30",
      "trackId": "WDATA",
      "t": 30,
      "y": 42,
      "text": "W beats @45 / 55 / 75 / 85ns",
      "content": "第 3 拍在 65ns 遇到背压，数据保持至 75ns 握手。WLAST 只在最后一拍为 1。",
      "size": 13,
      "color": "#ffe66d",
      "bgColor": "#252b35",
      "isSticky": true,
      "collapsed": true,
      "baseScale": 10
    },
    {
      "id": "note_BVALID_100",
      "trackId": "BVALID",
      "t": 100,
      "y": 42,
      "text": "WRITE burst #1: OKAY @125ns",
      "content": "BID=3，与 AWID 对应。写响应晚于四拍数据完成。",
      "size": 13,
      "color": "#ffe66d",
      "bgColor": "#252b35",
      "isSticky": true,
      "collapsed": true,
      "baseScale": 10
    },
    {
      "id": "note_ARADDR_140",
      "trackId": "ARADDR",
      "t": 140,
      "y": 42,
      "text": "READ burst #2: ID=5 / 4 beats",
      "content": "155ns 握手读地址。单 outstanding transaction 示例，不演示乱序返回。",
      "size": 13,
      "color": "#ffe66d",
      "bgColor": "#252b35",
      "isSticky": true,
      "collapsed": true,
      "baseScale": 10
    },
    {
      "id": "note_RDATA_180",
      "trackId": "RDATA",
      "t": 180,
      "y": 42,
      "text": "R beats @195 / 205 / 225 / 235ns",
      "content": "215ns 为背压等待；RID=5，RRESP=OKAY，RLAST 只标记第 4 拍。",
      "size": 13,
      "color": "#ffe66d",
