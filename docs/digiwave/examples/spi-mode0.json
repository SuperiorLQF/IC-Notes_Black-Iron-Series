      "t": 20,
      "y": 42,
      "text": "SPI transaction #1: 8 bits",
      "content": "CS_n 拉低后开始；SCLK 空闲为低，接收端在上升沿采样，发送端在下降沿切换下一位。",
      "size": 13,
      "color": "#ffe66d",
      "bgColor": "#252b35",
      "isSticky": true,
      "collapsed": true,
      "baseScale": 10
    },
    {
      "id": "note_MOSI_30",
      "trackId": "MOSI",
      "t": 30,
      "y": 42,
      "text": "TX 0xA5: 10100101",
      "content": "MSB first。采样点为 30、50、70、90、110、130、150、170ns。",
      "size": 13,
      "color": "#ffe66d",
      "bgColor": "#252b35",
      "isSticky": true,
      "collapsed": true,
      "baseScale": 10
    },
    {
      "id": "note_MISO_30",
      "trackId": "MISO",
      "t": 30,
      "y": 42,
      "text": "RX 0x3C: 00111100",
      "content": "与 MOSI 同时传输，200ns CS_n 拉高结束事务。",
      "size": 13,
      "color": "#ffe66d",
      "bgColor": "#252b35",
      "isSticky": true,
      "collapsed": true,
      "baseScale": 10
    }
